# Server config
PORT=4000

# Isi dengan string acak yang panjang (untuk menandatangani token login admin)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# Password admin (dipakai untuk cek login di /api/auth/login)
ADMIN_PASSWORD=ganti-dengan-password-admin

# ===== Firebase Admin SDK (Service Account) =====
# Ambil dari: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# File JSON yang didownload berisi field: project_id, client_email, private_key
FIREBASE_PROJECT_ID=vii-bilal-2026
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vii-bilal-2026.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_PRIVATE_KEY_DI_SINI\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://vii-bilal-2026-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_STORAGE_BUCKET=vii-bilal-2026.firebasestorage.app
